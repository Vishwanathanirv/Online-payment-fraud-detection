# Port for the API and dashboard
PORT=8080
# SQLite file for scored transactions and analyst labels
DB_FILE=./data/fraudlens.db
# Optional: protect simulator and rule controls (send as "Authorization: Bearer <token>")
ADMIN_TOKEN=
# Proxy hops in front of the API whose X-Forwarded-For is trusted (rate limits key on the client IP)
TRUST_PROXY=1
# Set to "off" to disable the built-in traffic simulator
SIMULATOR=on
